{
  "multipart": [
    {
      "apply": {
        "model": "rfnetwork:cable_core"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "rfnetwork:cable_down"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "rfnetwork:cable_up"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "rfnetwork:cable_north"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "rfnetwork:cable_south"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "rfnetwork:cable_west"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "rfnetwork:cable_east"
      }
    }
  ]
}
